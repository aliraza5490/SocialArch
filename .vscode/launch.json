{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Backend Dev Server",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "dev:backend"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Run Frontend Dev Server",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "dev:frontend"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Run All Dev Servers (Parallel)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "console": "integratedTerminal",
            "presentation": {
                "group": "dev"
            }
        },
        {
            "name": "Build All Projects",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "build"
            ],
            "console": "integratedTerminal",
            "presentation": {
                "group": "build"
            }
        },
        {
            "name": "Lint All Projects",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "lint"
            ],
            "console": "integratedTerminal",
            "presentation": {
                "group": "lint"
            }
        },
        {
            "name": "Check Types All Projects",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "check-types"
            ],
            "console": "integratedTerminal",
            "presentation": {
                "group": "check-types"
            }
        },
        {
            "name": "Format Code (Prettier)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "format"
            ],
            "console": "integratedTerminal",
            "presentation": {
                "group": "format"
            }
        }
    ],
    "compounds": [
        {
            "name": "Run Dev Servers (Separate Terminals)",
            "configurations": [
                "Run Backend Dev Server",
                "Run Frontend Dev Server"
            ]
        }
    ]
}