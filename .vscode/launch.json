{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run All Dev Servers (Turbo)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "console": "integratedTerminal",
            "presentation": {
                "group": "turbo"
            }
        },
        {
            "name": "Build All Projects (Turbo)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "build"
            ],
            "console": "integratedTerminal",
            "presentation": {
                "group": "turbo"
            }
        },
        {
