# Backend Configuration
NODE_ENV=development
PORT=3000

# Database
PG_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/socialarch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Redis Cache
REDIS_URL=redis://localhost:6379

# JWT & Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800
EMAIL_VERIFICATION_TOKEN_EXPIRATION=3600
RESET_PASSWORD_TOKEN_EXPIRATION=3600

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=noreply@socialarch.com

# Frontend
FRONTEND_URL=http://localhost:3001

# Admin User (for initial setup - should be removed in production)
SUPER_USER_EMAIL=admin@socialarch.com
SUPER_USER_PASSWORD=change_this_password
